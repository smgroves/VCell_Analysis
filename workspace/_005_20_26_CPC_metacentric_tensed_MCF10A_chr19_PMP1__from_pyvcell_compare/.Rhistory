tmp <- data.frame(
lambda = cv_model$lambda.min,
BIC = BIC
)
cv.mdls <- bind_rows(cv.mdls, tmp)
}
# Analyze the final model
best_model <- glmnet(
data.matrix(rna.ccle), data.matrix(resids), alpha = 1, intercept = F,
lambda = cv.mdls$lambda[which(cv.mdls$BIC == min(cv.mdls$BIC))][1]
)
## =========================================================================
## Save coefficients========================================================
coef.bm <- as.matrix(coef(best_model)) %>%
as.data.frame() %>%
arrange(s0) %>%
filter(s0 != 0)
coefs[[i]] <- setNames(split(coef.bm$s0, seq(length(coef.bm$s0))),
rownames(coef.bm))
names(coefs)[[i]] <- protein
return(coefs)
## =========================================================================
rm(list = setdiff(ls(), c("params", "rna.ccle.complete", "complete.gene.list", "files", "coefs", "i", "numCores", "BOOL")))
gc()
}
}
r <- unlist(r, recursive = F)
saveRDS(r, file = "FinalScripts/ManuscriptRevisions/LASSO_test_20231026.RData")
BOOL = FALSE
})
BOOL = TRUE
system.time(while (BOOL) {
r <- foreach (j = 1:length(files[1:5])) %dopar% {
pacman::p_load(tidyverse, glmnet, data.table)
file = files[j]
protein <- sub("\\..*", "", file)
if (protein %in% complete.gene.list) {
dat.protein <- fread(paste0("FinalScripts/DataFiles/CCLE_Data/csvfiles_TMTonly/", file), data.table = F) %>%
na.omit()
A <- params$A[params$GeneSymbol == protein]
B <- params$B[params$GeneSymbol == protein]
C <- params$C[params$GeneSymbol == protein]
dat.protein$Prediction <- A*(B*dat.protein$TPM/(C+dat.protein$TPM) + dat.protein$TPM)
resids <- data.frame(
row.names = dat.protein$CellLine,
resid = dat.protein$Prediction - dat.protein$Protein
)
rna.ccle <- rna.ccle.complete[rownames(resids),]
if (protein %in% colnames(rna.ccle)) {
rna.ccle <- rna.ccle[,-which(colnames(rna.ccle) == protein)]
}
## Perform LASSO============================================================
# Perform k-fold cross-validation to determine the optimal lambda. The optimal value is the one that minimizes the MSE. Setting alpha between 0 and 1 is equivalent to using an elastic net. Setting alpha = 0 would be a ridge regression.
set.seed(1010)
trials <- 5
cv.mdls <- data.frame()
for (trial in seq(1, trials)) {
glmnet.control(fdev = 0.01)
cv_model <- cv.glmnet(
data.matrix(rna.ccle), data.matrix(resids), alpha = 1, intercept = F
)
df <- data.frame(
GeneSymbol = coef(cv_model, s = "lambda.min")@Dimnames[[1]][which(coef(cv_model, s = "lambda.min") != 0)],
coef = coef(cv_model, s = "lambda.min")[which(coef(cv_model, s = "lambda.min") != 0)]
)
# Get significant features based on this iteration of LASSO
sig.features <- rna.ccle[rownames(resids), df$GeneSymbol] %>%
as.data.frame() %>%
`rownames<-`(value = rownames(resids)) %>%
`colnames<-`(value = df$GeneSymbol)
# Make predictions
preds <- as.vector(as.matrix(sig.features)%*%as.vector(df$coef))
## Calculate BIC==========================================================
N <- nrow(sig.features)
p <- ncol(sig.features)
sigma <- sqrt(sum((resids$resid - preds)^2)/(N-p)) * sqrt((N-p)/N) # standard deviation of the fit
# LL = sum(dnorm(resids$resid, mean = preds, sd = sigma, log = T))
BIC <- -2*sum(dnorm(resids$resid, mean = preds, sd = sigma, log = T)) + p*log(N)
## =======================================================================
tmp <- data.frame(
lambda = cv_model$lambda.min,
BIC = BIC
)
cv.mdls <- bind_rows(cv.mdls, tmp)
}
# Analyze the final model
best_model <- glmnet(
data.matrix(rna.ccle), data.matrix(resids), alpha = 1, intercept = F,
lambda = cv.mdls$lambda[which(cv.mdls$BIC == min(cv.mdls$BIC))][1]
)
## =========================================================================
## Save coefficients========================================================
coef.bm <- as.matrix(coef(best_model)) %>%
as.data.frame() %>%
arrange(s0) %>%
filter(s0 != 0)
coefs[[i]] <- setNames(split(coef.bm$s0, seq(length(coef.bm$s0))),
rownames(coef.bm))
names(coefs)[[i]] <- protein
return(coefs)
## =========================================================================
rm(list = setdiff(ls(), c("params", "rna.ccle.complete", "complete.gene.list", "files", "coefs", "i", "numCores", "BOOL")))
gc()
}
}
r <- unlist(r, recursive = F)
saveRDS(r, file = "FinalScripts/ManuscriptRevisions/LASSO_test_20231026.RData")
BOOL = FALSE
})
