source("~/Documents/GitHub/Pinferna/Calibrated_TMT_Shiny_App/BIC for LASSO vs HL vs med.R")
pacman::p_load(tidyverse, data.table)
csv_directory <- "/Users/smgroves/Documents/GitHub/Pinferna/Calibrated_TMT_Shiny_App/csvfiles_TMTonly/"
# Get CCLE file locations
files <- list.files(csv_directory, include.dirs = F)
# Read in LASSO coefficients
lasso.coefs <- readRDS("/Users/smgroves/Documents/GitHub/Pinferna/Calibrated_TMT_Shiny_App/Coefficients/LASSO_test_MFAP3.RData")
# Read in params
params <- fread("/Users/smgroves/Documents/GitHub/Pinferna/Calibrated_TMT_Shiny_App/RegressionParameters_MFAP3.csv") %>%
column_to_rownames(var = "GeneSymbol")
# Read in all CCLE transcriptomics
rna.ccle.complete <- fread("/Users/smgroves/Documents/GitHub/Pinferna/Calibrated_TMT_Shiny_App/CCLE_expression.csv", data.table = F) %>%
column_to_rownames(var = "GeneSymbol") %>%
t() %>% as.data.frame()
df <- data.frame()
i = 1
protein = "MFAP3"
# Just for me to keep track of how far along the code is...
if (i %in% seq(0,length(rownames(params)), by = 300)) {
cat(paste0(i, " "))
}
# Read in CCLE data
ccle.dat <- fread(paste0(csv_directory, files[which(gsub("\\..*", "\\1", files) == protein)])) %>%
na.omit() %>%
column_to_rownames(var = "CellLine")
N <- nrow(ccle.dat) # number of observations for calculating BIC
# Extract hyperbolic-to-linear parameters and TPM
A <- params[protein, "A"]
B <- params[protein, "B"]
C <- params[protein, "C"]
# Model that protein prediction (in any sample) is the median value
ccle.dat$Median <- rep(median(ccle.dat$Protein, na.rm = T), nrow(ccle.dat))
p <- 0 # median model has no parameters
sigma <- sqrt(sum((ccle.dat$Median - ccle.dat$Protein)^2)/(N-p)) * sqrt((N-p)/N)
# LogLikelihood <- sum(dnorm(ccle.dat$Protein, mean = ccle.dat$HL, sd = sigma, log = T))
BIC_Median <- -2*sum(dnorm(ccle.dat$Protein, mean = ccle.dat$Median, sd = sigma, log = T)) + p*log(N)
# Make predictions based on hyperlin
ccle.dat$HL <- A*( B*ccle.dat$TPM/(C+ccle.dat$TPM) + ccle.dat$TPM )
p <- 3 # number of parameters for hyperbolic-to-linear fit
sigma <- sqrt(sum((ccle.dat$HL - ccle.dat$Protein)^2)/(N-p)) * sqrt((N-p)/N) # standard deviation of the fit
# LogLikelihood <- sum(dnorm(ccle.dat$Protein, mean = ccle.dat$HL, sd = sigma, log = T))
BIC_HL <- -2*sum(dnorm(ccle.dat$Protein, mean = ccle.dat$HL, sd = sigma, log = T)) + p*log(N)
# Create column for LASSO predictions
ccle.dat$LASSO <- NA
# Get the coefficients for the significant features for the current protein
sigfeats <- as.data.frame(lasso.coefs[[protein]])
# Make predictions (if applicable, i.e., if there were significant features)
if (ncol(sigfeats) >= 1 & nrow(sigfeats) == 1) {
# Extract the transcriptomic data in the CCLE for those features
rna.sigfeats <- rna.ccle.complete[rownames(ccle.dat),] %>%
select(one_of(colnames(sigfeats)))
sigfeats <- sigfeats %>% select(colnames(rna.sigfeats))
ccle.dat$LASSO <- ccle.dat$HL - c(as.matrix(rna.sigfeats)%*%as.matrix(t(sigfeats)))
p <- 3+ncol(sigfeats) # number of parameters for hyperbolic-to-linear+ LASSO fit
sigma <- sqrt(sum((ccle.dat$LASSO - ccle.dat$Protein)^2)/(N-p)) * sqrt((N-p)/N) # standard deviation of the fit
# LL_LASSO <- sum(dnorm(ccle.dat$Protein, mean = ccle.dat$LASSO, sd = sigma, log = T))
BIC_LASSO <- -2*sum(dnorm(ccle.dat$Protein, mean = ccle.dat$LASSO, sd = sigma, log = T)) + p*log(N)
tmp <- data.frame(GeneSymbol = protein,
Median = BIC_Median,
HL = BIC_HL,
LASSO = BIC_LASSO)
df <- bind_rows(df, tmp)
} else {
tmp <- data.frame(GeneSymbol = protein,
Median = BIC_Median,
HL = BIC_HL,
LASSO = NA)
df <- bind_rows(df, tmp)
}
# Extract the transcriptomic data in the CCLE for those features
rna.sigfeats <- rna.ccle.complete[rownames(ccle.dat),] %>%
select(one_of(colnames(sigfeats)))
rna.sigfeats <- rna.ccle.complete[rownames(ccle.dat),]
# Extract the transcriptomic data in the CCLE for those features
rna.sigfeats <- rna.ccle.complete[rownames(ccle.dat),] %>%
dplyr::select(one_of(colnames(sigfeats)))
