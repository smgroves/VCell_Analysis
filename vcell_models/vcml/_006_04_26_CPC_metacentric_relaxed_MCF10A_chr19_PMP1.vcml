          <BoundaryType Boundary="Xm" Type="Flux" />
          <BoundaryType Boundary="Xp" Type="Flux" />
          <BoundaryType Boundary="Ym" Type="Flux" />
          <BoundaryType Boundary="Yp" Type="Flux" />
          <BoundaryType Boundary="Zm" Type="Value" />
          <BoundaryType Boundary="Zp" Type="Value" />
          <PdeEquation Name="HASPINi" SolutionType="Unknown">
            <Rate>( - J_HASPIN_activation_PLK1a + J_HASPIN_deactivation - J_HASPIN_activation_panCPCa)</Rate>
            <Diffusion>HASPINi_diffusionRate</Diffusion>
            <Initial>HASPINi_init_uM</Initial>
          </PdeEquation>
          <PdeEquation Name="HASPINa" SolutionType="Unknown">
            <Rate>(J_HASPIN_activation_PLK1a - J_HASPIN_deactivation + J_HASPIN_activation_panCPCa)</Rate>
            <Diffusion>HASPINa_diffusionRate</Diffusion>
            <Initial>HASPINa_init_uM</Initial>
          </PdeEquation>
          <PdeEquation Name="PLK1a" SolutionType="Unknown">
            <Rate>(J_PLK1_activation_panCPCa - J_PLK1_deactivation)</Rate>
            <Diffusion>PLK1a_diffusionRate</Diffusion>
            <Initial>PLK1a_init_uM</Initial>
          </PdeEquation>
          <PdeEquation Name="H3" SolutionType="Unknown">
            <Rate>( - J_H3_phos_HASPINa + J_pH3_dephos - J_H3_CPCi_binding - J_H3_CPCa_binding)</Rate>
            <Diffusion>H3_diffusionRate</Diffusion>
            <Initial>H3_init_uM</Initial>
          </PdeEquation>
          <PdeEquation Name="pH3" SolutionType="Unknown">
