            <Diffusion>pH3_diffusionRate</Diffusion>
            <Initial>pH3_init_uM</Initial>
          </PdeEquation>
          <PdeEquation Name="pKNL1" SolutionType="Unknown">
            <Rate>( - J_pKNL1_BUB1a_binding + J_KNL1_phos_panTTK - J_pKNL1_dephos + J_KNL1_phos_PLK1a + J_pKNL1_bub1a_unbinding)</Rate>
            <Diffusion>pKNL1_diffusionRate</Diffusion>
            <Initial>pKNL1_init_uM</Initial>
          </PdeEquation>
          <PdeEquation Name="BUB1a" SolutionType="Unknown">
            <Rate>( - J_pKNL1_BUB1a_binding + J_BUB1a_pknl1_unbinding)</Rate>
            <Diffusion>BUB1a_diffusionRate</Diffusion>
            <Initial>BUB1a_init_uM</Initial>
          </PdeEquation>
          <PdeEquation Name="H2A" SolutionType="Unknown">
            <Rate>( - J_H2A_phos_BUB1a + J_pH2A_dephos - J_H2A_phos_BUB1a_pknl1)</Rate>
            <Diffusion>H2A_diffusionRate</Diffusion>
            <Initial>H2A_init_uM</Initial>
          </PdeEquation>
          <PdeEquation Name="pH2A" SolutionType="Unknown">
            <Rate>(J_H2A_phos_BUB1a - J_pH2A_dephos - J_pH2A_SGO1_binding - J_SGO1_CPCi_pH2A_binding - J_SGO1_CPCa_pH2A_binding + J_H2A_phos_BUB1a_pknl1)</Rate>
            <Diffusion>pH2A_diffusionRate</Diffusion>
            <Initial>pH2A_init_uM</Initial>
          </PdeEquation>
          <PdeEquation Name="SGO1" SolutionType="Unknown">
