        <Function Name="pNDC80_TTKi_velocityY" Domain="chromosome">( - (y - y_mid) / delT * scale_y * exp(( - ((y - y_mid) ^ 2.0) / (2.0 * (sigma_y_y ^ 2.0)))))</Function>
        <Function Name="pNDC80_velocityX" Domain="chromosome">(((x - x_mid) / delT * exp(( - ((x - x_mid) ^ 2.0) / (2.0 * (sigma_x_X ^ 2.0)))) / norm_x_x * ((y &gt;= kin_y1) &amp;&amp; (y &lt;= kin_y2) &amp;&amp; (x &gt;= 0.3625) &amp;&amp; (x &lt;= 0.9375))) + ( - max_vel * ((y &gt;= kin_y1) &amp;&amp; (y &lt;= kin_y2) &amp;&amp; (x &lt; 0.3625))) + (max_vel * ((y &gt;= kin_y1) &amp;&amp; (y &lt;= kin_y2) &amp;&amp; (x &gt; 0.9375))))</Function>
        <Function Name="pNDC80_velocityY" Domain="chromosome">( - (y - y_mid) / delT * scale_y * exp(( - ((y - y_mid) ^ 2.0) / (2.0 * (sigma_y_y ^ 2.0)))))</Function>
