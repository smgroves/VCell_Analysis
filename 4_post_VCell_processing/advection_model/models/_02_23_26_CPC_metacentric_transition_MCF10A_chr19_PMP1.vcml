        <Function Name="x_mid">(chrW / 2.0)</Function>
        <Function Name="y_mid">(chrH / 2.0)</Function>
        <CompartmentSubDomain Name="chromosome">
          <BoundaryType Boundary="Xm" Type="Flux" />
          <BoundaryType Boundary="Xp" Type="Flux" />
          <BoundaryType Boundary="Ym" Type="Flux" />
          <BoundaryType Boundary="Yp" Type="Flux" />
          <BoundaryType Boundary="Zm" Type="Value" />
          <BoundaryType Boundary="Zp" Type="Value" />
          <PdeEquation Name="HASPINi" SolutionType="Unknown">
            <Rate>( - J_HASPIN_activation_PLK1a + J_HASPIN_deactivation - J_HASPIN_activation_panCPCa)</Rate>
            <Diffusion>HASPINi_diffusionRate</Diffusion>
            <Initial>HASPINi_init_uM</Initial>
          </PdeEquation>
          <PdeEquation Name="HASPINa" SolutionType="Unknown">
            <Rate>(J_HASPIN_activation_PLK1a - J_HASPIN_deactivation + J_HASPIN_activation_panCPCa)</Rate>
            <Diffusion>HASPINa_diffusionRate</Diffusion>
            <Initial>HASPINa_init_uM</Initial>
          </PdeEquation>
          <PdeEquation Name="PLK1a" SolutionType="Unknown">
            <Rate>(J_PLK1_activation_panCPCa - J_PLK1_deactivation + J_PLK1a_input)</Rate>
            <Diffusion>PLK1a_diffusionRate</Diffusion>
            <Initial>PLK1a_init_uM</Initial>
          </PdeEquation>
          <PdeEquation Name="H3" SolutionType="Unknown">
            <Rate>( - J_H3_phos_HASPINa + J_pH3_dephos - J_H3_CPCi_binding - J_H3_CPCa_binding)</Rate>
            <Diffusion>H3_diffusionRate</Diffusion>
            <Initial>H3_init_uM</Initial>
            <Velocity X="H3_velocityX" />
          </PdeEquation>
          <PdeEquation Name="pH3" SolutionType="Unknown">
            <Rate>(J_H3_phos_HASPINa - J_pH3_dephos - J_pH3_CPCi_binding - J_pH3_CPCa_binding)</Rate>
            <Diffusion>pH3_diffusionRate</Diffusion>
            <Initial>pH3_init_uM</Initial>
            <Velocity X="pH3_velocityX" />
          </PdeEquation>
          <PdeEquation Name="pKNL1" SolutionType="Unknown">
            <Rate>( - J_pKNL1_BUB1a_binding + J_BUB1a_pKNL1_unbinding + J_KNL1_phos_panTTK - J_pKNL1_dephos + J_KNL1_phos_PLK1a)</Rate>
            <Diffusion>pKNL1_diffusionRate</Diffusion>
            <Initial>pKNL1_init_uM</Initial>
          </PdeEquation>
          <PdeEquation Name="BUB1a_pKNL1" SolutionType="Unknown">
            <Rate>(J_pKNL1_BUB1a_binding - J_BUB1a_pKNL1_unbinding)</Rate>
            <Diffusion>BUB1a_pKNL1_diffusionRate</Diffusion>
            <Initial>BUB1a_pKNL1_init_uM</Initial>
          </PdeEquation>
          <PdeEquation Name="BUB1a" SolutionType="Unknown">
            <Rate>( - J_pKNL1_BUB1a_binding + J_BUB1a_his_release)</Rate>
            <Diffusion>BUB1a_diffusionRate</Diffusion>
            <Initial>BUB1a_init_uM</Initial>
          </PdeEquation>
          <PdeEquation Name="H2A" SolutionType="Unknown">
            <Rate>( - J_H2A_phos_BUB1a_BUB1a_his_BUB1a_pKNL1 + J_pH2A_dephos)</Rate>
            <Diffusion>H2A_diffusionRate</Diffusion>
            <Initial>H2A_init_uM</Initial>
            <Velocity X="H2A_velocityX" />
          </PdeEquation>
          <PdeEquation Name="pH2A" SolutionType="Unknown">
            <Rate>(J_H2A_phos_BUB1a_BUB1a_his_BUB1a_pKNL1 - J_pH2A_dephos - J_pH2A_SGO1_binding - J_SGO1_CPCi_pH2A_binding - J_SGO1_CPCa_pH2A_binding)</Rate>
            <Diffusion>pH2A_diffusionRate</Diffusion>
            <Initial>pH2A_init_uM</Initial>
            <Velocity X="pH2A_velocityX" />
          </PdeEquation>
          <PdeEquation Name="BUB1a_his" SolutionType="Unknown">
            <Rate>(J_BUB1a_pKNL1_unbinding - J_BUB1a_his_release)</Rate>
            <Diffusion>BUB1a_his_diffusionRate</Diffusion>
            <Initial>BUB1a_his_init_uM</Initial>
          </PdeEquation>
          <PdeEquation Name="SGO1" SolutionType="Unknown">
            <Rate>( - J_pH2A_SGO1_binding - J_SGO1_CPCi_binding - J_SGO1_CPCa_binding)</Rate>
            <Diffusion>SGO1_diffusionRate</Diffusion>
            <Initial>SGO1_init_uM</Initial>
          </PdeEquation>
          <PdeEquation Name="pH2A_SGO1" SolutionType="Unknown">
            <Rate>(J_pH2A_SGO1_binding - J_pH2A_SGO1_CPCi_binding - J_pH2A_SGO1_CPCa_binding)</Rate>
            <Diffusion>pH2A_SGO1_diffusionRate</Diffusion>
            <Initial>pH2A_SGO1_init_uM</Initial>
            <Velocity X="pH2A_SGO1_velocityX" />
          </PdeEquation>
          <PdeEquation Name="CPCi" SolutionType="Unknown">
            <Rate>( - J_pH3_CPCi_binding - J_pH2A_SGO1_CPCi_binding - J_CPC_cis_activation - J_CPC_trans_activation_panCPCa - J_SGO1_CPCi_binding - J_H3_CPCi_binding)</Rate>
            <Diffusion>CPCi_diffusionRate</Diffusion>
            <Initial>CPCi_init_uM</Initial>
          </PdeEquation>
          <PdeEquation Name="pH3_CPCi" SolutionType="Unknown">
            <Rate>(J_pH3_CPCi_binding - J_pH3_CPC_cis_activation - J_pH3_CPC_trans_activation_panCPCa)</Rate>
            <Diffusion>pH3_CPCi_diffusionRate</Diffusion>
            <Initial>pH3_CPCi_init_uM</Initial>
            <Velocity X="pH3_CPCi_velocityX" />
          </PdeEquation>
          <PdeEquation Name="pH2A_SGO1_CPCi" SolutionType="Unknown">
            <Rate>(J_pH2A_SGO1_CPCi_binding - J_pH2A_SGO1_CPC_cis_activation - J_pH2A_SGO1_CPC_trans_activation_panCPCa + J_SGO1_CPCi_pH2A_binding)</Rate>
            <Diffusion>pH2A_SGO1_CPCi_diffusionRate</Diffusion>
            <Initial>pH2A_SGO1_CPCi_init_uM</Initial>
            <Velocity X="pH2A_SGO1_CPCi_velocityX" />
          </PdeEquation>
          <PdeEquation Name="CPCa" SolutionType="Unknown">
            <Rate>(J_CPC_cis_activation + J_CPC_trans_activation_panCPCa - J_pH3_CPCa_binding - J_pH2A_SGO1_CPCa_binding - J_SGO1_CPCa_binding - J_H3_CPCa_binding)</Rate>
            <Diffusion>CPCa_diffusionRate</Diffusion>
            <Initial>CPCa_init_uM</Initial>
          </PdeEquation>
          <PdeEquation Name="pH3_CPCa" SolutionType="Unknown">
            <Rate>(J_pH3_CPC_cis_activation + J_pH3_CPC_trans_activation_panCPCa + J_pH3_CPCa_binding)</Rate>
            <Diffusion>pH3_CPCa_diffusionRate</Diffusion>
            <Initial>pH3_CPCa_init_uM</Initial>
            <Velocity X="pH3_CPCa_velocityX" />
