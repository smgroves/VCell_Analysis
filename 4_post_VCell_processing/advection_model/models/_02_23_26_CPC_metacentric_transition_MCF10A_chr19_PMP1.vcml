        <Function Name="pNDC80_pTTKi_velocityY" Domain="chromosome">( - (y - y_mid) / delT * scale_y * exp(( - ((y - y_mid) ^ 2.0) / (2.0 * (sigma_y_y ^ 2.0)))))</Function>
